{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "DATABASE_URL",
    "POSTGRES_URL",
    "GROQ_KEY",
    "GROQ_API_KEY",
    "BETTER_AUTH_SECRET",
    "BETTER_AUTH_API_KEY",
    "BETTER_AUTH_URL",
    "RESEND_API_KEY",
    "EMAIL_FROM",
    "NODE_ENV"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"],
      "env": [
        "DATABASE_URL",
        "POSTGRES_URL",
        "GROQ_KEY",
        "GROQ_API_KEY",
        "BETTER_AUTH_SECRET",
        "BETTER_AUTH_API_KEY",
        "BETTER_AUTH_URL",
        "RESEND_API_KEY",
        "EMAIL_FROM"
      ]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
